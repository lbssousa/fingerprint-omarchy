# Maintainer: Laércio de Sousa <laercio@sivali.sousa.nom.br>
#
# Builds from the repository this PKGBUILD lives in (the parent of
# $startdir), so `makepkg` in packaging/ packages the working tree as is.

pkgname=fingerprint-omarchy
pkgver=0.1.1
pkgrel=1
pkgdesc='Enroll, test and delete fingerprints from an omarchy-shell overlay (fprintd)'
arch=(any)
url='https://github.com/lbssousa/fingerprint-omarchy'
license=(MIT)
depends=(omarchy fprintd python python-gobject)
checkdepends=(nodejs)
install=fingerprint-omarchy.install

_srcroot() { cd "$startdir/.."; }

check() {
  _srcroot
  node --test tests/js/
  python3 -I -m unittest discover -s tests/py
}

package() {
  _srcroot
  local share="$pkgdir/usr/share/fingerprint-omarchy/plugin"
  install -Dm644 -t "$share" plugin/manifest.json plugin/*.qml plugin/*.js
  install -Dm755 -t "$share" plugin/fprint-helper
  install -Dm644 -t "$share/i18n" plugin/i18n/*.json
  install -Dm755 -t "$pkgdir/usr/bin" bin/omarchy-fingerprint

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
